<?xml version="1.0" encoding="utf-8"?>
<!-- Streak widget (2×1): the flame, the streak, and whether today is done.
     Filled in by StreakWidget; sample texts are for the widget picker's
     preview. The status line is hidden when the widget is too short for it.

     The glow around the flame is an indeterminate ProgressBar — the one
     animation a launcher runs inside a widget by itself. It only shows while
     today's studying is still to do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/studytrail_streak_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ProgressBar
            android:id="@+id/streak_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_streak_glow"
            android:indeterminateDuration="1800" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_circle_bg"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_widget_flame" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/streak_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="12"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/streak_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="day streak"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/streak_status_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/streak_status_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_check" />

            <TextView
                android:id="@+id/streak_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Done today"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
