<?xml version="1.0" encoding="utf-8"?>
<!-- Streak: coral into amber, the app's streak colours.
     The ripple is the tap feedback: the whole widget flashes white where it
     was pressed before the app opens. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FFF59E0B"
                android:startColor="#FFFE6F42"
                android:type="linear" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</ripple>
