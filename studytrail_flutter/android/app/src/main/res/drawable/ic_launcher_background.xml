<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the app's primary gradient, drawn as a vector so
     it stays sharp at every mask shape the launcher applies. The foreground
     PNGs are generated (see docs/FLOW.md); this one is hand-written because a
     gradient fill is cheaper as a vector than as five more bitmaps. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF24389C" />
                <item android:offset="1" android:color="#FF3F51B5" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
