<?xml version="1.0" encoding="utf-8"?>
<!-- A comet of light circling the flame while today's streak is still open.
     Drawn by an indeterminate ProgressBar, the one kind of animation a
     launcher runs inside a widget on its own. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360">
    <shape
        android:innerRadiusRatio="2.5"
        android:shape="ring"
        android:thicknessRatio="14"
        android:useLevel="false">
        <gradient
            android:centerColor="#40FFFFFF"
            android:endColor="#FFFFFFFF"
            android:startColor="#00FFFFFF"
            android:type="sweep"
            android:useLevel="false" />
    </shape>
</rotate>
