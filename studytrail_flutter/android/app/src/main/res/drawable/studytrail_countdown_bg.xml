<?xml version="1.0" encoding="utf-8"?>
<!-- Exam countdown: violet, the doubt board's colour in the app.
     The ripple is the tap feedback: the whole widget flashes white where it
     was pressed before the app opens. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF8B5CF6"
                android:startColor="#FF5B21B6"
                android:type="linear" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</ripple>
