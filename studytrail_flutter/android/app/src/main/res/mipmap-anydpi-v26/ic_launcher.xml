<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 and up masks this to whatever shape the launcher uses, so the
     mark sits inside the inner 72dp safe zone and the gradient runs full
     bleed. The flat `mipmap-*/ic_launcher.png` files remain the fallback for
     older devices. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+) tint the foreground's alpha, and the mark is
         already a white silhouette, so it reuses the same asset. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
